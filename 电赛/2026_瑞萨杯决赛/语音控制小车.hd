<xml xmlns="http://www.w3.org/1999/xhtml"><block type="setup" id="vc_setup_001" x="0" y="0"><statement name="DO"><block type="asr_speak" id="vc_speak_001"><field name="VOICE_SET">橙子-甜美客服</field><field name="vol">10</field><field name="speed">10</field><next><block type="asr_welcom" id="vc_welcom_001"><field name="NAME">欢迎使用语音小车，用小杜唤醒我。</field><next><block type="asr_sleep" id="vc_sleep_001"><field name="NAME">我退下了，用小杜唤醒我</field><next><block type="asr_id" id="vc_id_wake"><field name="ASR">小杜</field><field name="leibie">唤醒词</field><field name="huifu">我在</field><field name="id">0</field><next><block type="asr_id" id="vc_id_fwd"><field name="ASR">前进</field><field name="leibie">命令词</field><field name="huifu">好的，小车前进</field><field name="id">1</field><next><block type="asr_id" id="vc_id_back"><field name="ASR">后退</field><field name="leibie">命令词</field><field name="huifu">好的，小车后退</field><field name="id">2</field><next><block type="asr_id" id="vc_id_left"><field name="ASR">左转</field><field name="leibie">命令词</field><field name="huifu">好的，小车左转</field><field name="id">3</field><next><block type="asr_id" id="vc_id_right"><field name="ASR">右转</field><field name="leibie">命令词</field><field name="huifu">好的，小车右转</field><field name="id">4</field><next><block type="asr_id" id="vc_id_stop"><field name="ASR">停止</field><field name="leibie">命令词</field><field name="huifu">好的，小车停止</field><field name="id">5</field><next><block type="serial_begin" id="vc_serial_begin"><field name="serial_select">Serial</field><field name="TX">PB_5</field><field name="RX">PB_6</field><value name="CONTENT"><shadow type="baud" id="vc_baud"><field name="baud">9600</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="hardware_init" id="vc_hw_init" x="0" y="348"><statement name="DO"><block type="vol_set" id="vc_vol_set"><value name="num"><shadow type="asr_vol" id="vc_asr_vol"><field name="PIN">7</field></shadow></value></block></statement></block><block type="thread_app" id="vc_thread" x="0" y="480"><field name="app_name">app</field><field name="uxPriority">4</field><field name="mem">128</field><statement name="DO"><block type="controls_repeat_forever" id="vc_loop"><statement name="DO"><block type="haodabit_DELAY1" id="vc_delay"><value name="ioinput"><shadow type="math_number" id="vc_delay_num"><field name="NUM">10</field></shadow></value></block></statement></block></statement></block><block type="procedures_defnoreturn" id="vc_asr_code" x="0" y="620"><field name="NAME">ASR_CODE</field><comment pinned="false" h="80" w="160">语音识别回调：识别到命令词后通过串口发送指令给瑞萨，回复语音自动播放</comment><statement name="STACK"><block type="enter_wakeup" id="vc_enter_wakeup"><value name="num"><shadow type="math_number" id="vc_wakeup_num"><field name="NUM">10</field></shadow></value><next><block type="controls_if" id="vc_if_main"><mutation elseif="4"></mutation><value name="IF0"><block type="logic_compare" id="vc_cmp_fwd"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="vc_snid_fwd"><field name="VAR">snid</field></block></value><value name="B"><block type="math_number" id="vc_num_fwd"><field name="NUM">1</field></block></value></block></value><statement name="DO0"><block type="serial_write" id="vc_write_fwd"><field name="serial_select">Serial</field><value name="CONTENT"><shadow type="math_number" id="vc_data_fwd"><field name="NUM">1</field></shadow></value></block></statement><value name="IF1"><block type="logic_compare" id="vc_cmp_back"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="vc_snid_back"><field name="VAR">snid</field></block></value><value name="B"><block type="math_number" id="vc_num_back"><field name="NUM">2</field></block></value></block></value><statement name="DO1"><block type="serial_write" id="vc_write_back"><field name="serial_select">Serial</field><value name="CONTENT"><shadow type="math_number" id="vc_data_back"><field name="NUM">2</field></shadow></value></block></statement><value name="IF2"><block type="logic_compare" id="vc_cmp_left"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="vc_snid_left"><field name="VAR">snid</field></block></value><value name="B"><block type="math_number" id="vc_num_left"><field name="NUM">3</field></block></value></block></value><statement name="DO2"><block type="serial_write" id="vc_write_left"><field name="serial_select">Serial</field><value name="CONTENT"><shadow type="math_number" id="vc_data_left"><field name="NUM">3</field></shadow></value></block></statement><value name="IF3"><block type="logic_compare" id="vc_cmp_right"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="vc_snid_right"><field name="VAR">snid</field></block></value><value name="B"><block type="math_number" id="vc_num_right"><field name="NUM">4</field></block></value></block></value><statement name="DO3"><block type="serial_write" id="vc_write_right"><field name="serial_select">Serial</field><value name="CONTENT"><shadow type="math_number" id="vc_data_right"><field name="NUM">4</field></shadow></value></block></statement><value name="IF4"><block type="logic_compare" id="vc_cmp_stop"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="vc_snid_stop"><field name="VAR">snid</field></block></value><value name="B"><block type="math_number" id="vc_num_stop"><field name="NUM">5</field></block></value></block></value><statement name="DO4"><block type="serial_write" id="vc_write_stop"><field name="serial_select">Serial</field><value name="CONTENT"><shadow type="math_number" id="vc_data_stop"><field name="NUM">0</field></shadow></value></block></statement></block></next></block></statement></block></xml>
